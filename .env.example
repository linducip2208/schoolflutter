# Copy to .env (local only, NEVER commit .env).
# Production builds use --dart-define, not .env files.
# See README for build commands.

# Development (Android emulator → host Laravel)
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Production (canonical — set via --dart-define in CI, not here)
# API_BASE_URL=https://eschool.whitelabel.co.id/api/v1
# APP_ENV=production

# Realtime (Laravel Reverb / Pusher-compatible)
PUSHER_KEY=local
PUSHER_HOST=10.0.2.2
PUSHER_PORT=6001
PUSHER_CLUSTER=ap1
PUSHER_TLS=false

# App
APP_NAME=eSchool
APP_ENV=development
